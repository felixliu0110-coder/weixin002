{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POC-01 Evaluation Case",
  "type": "object",
  "required": ["pocId", "caseId", "input", "variant", "provider"],
  "properties": {
    "pocId": {
      "type": "string",
      "const": "POC-01"
    },
    "caseId": {
      "type": "string",
      "description": "Unique identifier for this evaluation case"
    },
    "input": {
      "type": "object",
      "required": ["file", "width", "height"],
      "properties": {
        "file": { "type": "string", "description": "Path or URI of the input image" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "variant": {
      "type": "string",
      "enum": ["original", "normalized"],
      "description": "Whether this evaluation uses the original or normalized reference"
    },
    "provider": {
      "type": "string",
      "description": "Try-On provider identifier (e.g. agnes)"
    },
    "model": {
      "type": "string",
      "description": "Model version or identifier used by the provider"
    },
    "parameters": {
      "type": "object",
      "description": "Provider-specific parameters"
    },
    "avatarId": {
      "type": "string",
      "description": "Avatar / digital human identifier"
    },
    "garmentId": {
      "type": "string",
      "description": "Garment catalog identifier"
    },
    "taskId": {
      "type": "string",
      "description": "Provider task / job identifier"
    },
    "durationMs": {
      "type": ["number", "null"],
      "description": "Wall-clock duration in milliseconds"
    },
    "cost": {
      "type": ["number", "null"],
      "description": "Monetary cost of this evaluation"
    },
    "result": {
      "type": "object",
      "properties": {
        "success": { "type": ["boolean", "null"] },
        "outputFile": { "type": "string" }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "color": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
        "pattern": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
        "neckline": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
        "sleeve": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
        "length": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
        "silhouette": { "type": ["number", "null"], "minimum": 0, "maximum": 2 },
        "total": { "type": ["number", "null"], "minimum": 0, "maximum": 12 },
        "personConsistency": { "type": ["number", "null"] }
      }
    },
    "notes": {
      "type": "string"
    },
    "conclusion": {
      "type": "string"
    }
  }
}
