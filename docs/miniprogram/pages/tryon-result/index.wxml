<view class="wx-page">
  <nav-bar title="穿搭效果" showBack="{{true}}"></nav-bar>

  <view class="content">
    <!-- 主展示：图片 -->
    <view class="photo-card">
      <image src="{{result.tryonImage}}" mode="widthFix" class="result-img" />
      <view class="wm">效果示意，仅供参考</view>
    </view>

    <!-- 穿搭信息 -->
    <card class="result-meta">
      <view class="rm-copy">
        <view class="rm-title">{{result.garmentName}}</view>
        <view class="rm-sub">按你的身材生成，默认正面视角。</view>
      </view>
    </card>

    <!-- 操作按钮：纵向排列 -->
    <view class="action-list">
      <view class="action-item {{collecting ? 'action-active' : ''}}" hover-class="action-hover" bindtap="onCollect">
        <image class="action-icon" src="/assets/icons/svg/ic-heart.svg" mode="aspectFit" />
        <text class="action-label">收藏</text>
        <text class="action-hint">保存到试穿记录</text>
      </view>
      <view class="action-item" hover-class="action-hover" bindtap="onSaveTemplate">
        <image class="action-icon" src="/assets/icons/svg/ic-hanger.svg" mode="aspectFit" />
        <text class="action-label">保存模板</text>
        <text class="action-hint">将单件衣物加入衣物库</text>
      </view>
      <view class="action-item" hover-class="action-hover" bindtap="onShare">
        <image class="action-icon" src="/assets/icons/svg/ic-share.svg" mode="aspectFit" />
        <text class="action-label">分享</text>
        <text class="action-hint">发送给好友</text>
        <button class="share-btn" open-type="share" style="position:absolute;inset:0;opacity:0"></button>
      </view>
      <view class="action-item action-video" hover-class="action-hover" bindtap="goToVideoGenerate">
        <image class="action-icon" src="/assets/icons/svg/ic-play.svg" mode="aspectFit" />
        <text class="action-label">{{result.tryonVideo ? '观看动态视频' : '生成动态视频'}}</text>
        <text class="action-hint">{{result.tryonVideo ? '动态转身效果' : '生成转身动态效果'}}</text>
      </view>
    </view>
  </view>

  <tab-bar selected="{{1}}" navMode="{{true}}"></tab-bar>

  <!-- 收藏确认弹层 -->
  <sheet visible="{{collectVisible}}" bind:cancel="closeCollect">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">收藏成功</text>
      <text class="sheet-desc">是否同时保存到相册？</text>
    </view>
    <view slot="actions">
      <view class="collect-actions">
        <btn class="collect-btn" type="primary" bindtap="collectYes">是，保存到相册</btn>
        <btn class="collect-btn" type="secondary" bindtap="collectNo">否，仅收藏</btn>
      </view>
    </view>
  </sheet>

  <!-- 保存模板弹层（多选衣物） -->
  <sheet visible="{{templateVisible}}" bind:cancel="closeTemplate">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">保存到模板衣物</text>
      <text class="sheet-desc">选择本次穿搭中要保存到衣物库的单品，可分别编辑名称和分类</text>
    </view>

    <!-- 衣物列表 -->
    <view class="tpl-garment-list">
      <view
        wx:for="{{tplGarments}}"
        wx:key="id"
        class="tpl-garment-item {{item._checked ? 'tpl-garment-checked' : ''}}"
        bindtap="toggleTplGarment"
        data-idx="{{index}}"
      >
        <view class="tpl-garment-check">
          <view class="check-circle {{item._checked ? 'check-on' : ''}}">
            <view wx:if="{{item._checked}}" class="check-tick"></view>
          </view>
        </view>
        <image class="tpl-garment-img" src="{{item.image}}" mode="aspectFill" />
        <view class="tpl-garment-info">
          <text class="tpl-garment-name">{{item._editName}}</text>
          <text class="tpl-garment-cat">{{item._editCategory}}</text>
        </view>
        <view class="tpl-garment-edit" catchtap="openTplEdit" data-idx="{{index}}">
          <text class="edit-text">编辑</text>
        </view>
      </view>
    </view>

    <view slot="actions">
      <view class="template-actions">
        <btn class="sheet-action" type="primary" bindtap="confirmSaveTemplate">
          保存选中（{{tplSelected.length}} 件）
        </btn>
        <btn class="sheet-action" type="secondary" bindtap="closeTemplate">取消</btn>
      </view>
    </view>
  </sheet>

  <!-- 单件衣物编辑弹层 -->
  <sheet visible="{{tplEditIndex >= 0}}" bind:cancel="closeTplEdit">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">编辑衣物信息</text>
    </view>
    <view class="tpl-form">
      <view class="tpl-field">
        <text class="tpl-label">衣物名称</text>
        <input class="tpl-input" value="{{tplEditName}}" bindinput="onTplEditName" placeholder="输入衣物名称" maxlength="20" />
      </view>
      <view class="tpl-field">
        <text class="tpl-label">衣物分类</text>
        <view class="cat-grid">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-chip {{tplEditCategory === item ? 'on' : ''}}"
            hover-class="cat-chip-hover"
            data-cat="{{item}}"
            bindtap="onTplEditCategory"
          >{{item}}</view>
        </view>
      </view>
    </view>
    <view slot="actions">
      <view class="template-actions">
        <btn class="sheet-action" type="primary" bindtap="confirmTplEdit">确认</btn>
        <btn class="sheet-action" type="secondary" bindtap="closeTplEdit">取消</btn>
      </view>
    </view>
  </sheet>
</view>
