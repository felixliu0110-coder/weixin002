<view class="wx-page">
  <nav-bar title="选择衣物" showBack="{{true}}" backRoute="/pages/home/index">
    <view wx:if="{{tab === 'lib' && viewMode === 'home'}}" slot="right" class="manage-btn" hover-class="manage-hover" bindtap="toggleManage">{{manageMode ? '完成' : '管理'}}</view>
    <view wx:if="{{tab === 'lib' && viewMode === 'select'}}" slot="right" class="manage-btn" hover-class="manage-hover" bindtap="toggleLibManage">{{libManageMode ? '完成' : '管理'}}</view>
  </nav-bar>

  <view class="content">
    <seg options="{{tabs}}" value="{{tab}}" bindchange="onTab" />

    <!-- 模板衣物 -->
    <block wx:if="{{tab === 'lib'}}">
      <!-- 分类入口 + 我的模板 -->
      <block wx:if="{{viewMode === 'home'}}">
        <view class="hint">点击分类选择衣物，加入下面的「已选穿搭」</view>
        <view class="cat-cards">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-card"
            hover-class="cat-card-hover"
            data-cat="{{item}}"
            bindtap="onCatCard"
          >
            <image class="cat-icon" src="{{catIcons[item]}}" mode="aspectFit" />
            <text class="cat-name">{{item}}</text>
            <text class="cat-count">{{catCounts[item] || 0}} 件</text>
          </view>
        </view>

        <view class="sec-hd">
          <text class="sec-title">已选穿搭衣物</text>
          <text class="hint">长按可删除</text>
        </view>
        <view wx:if="{{myTemplates.length === 0 && !manageMode}}" class="cat-empty">还没选择衣物，点击上方分类挑选</view>
        <view class="garment-grid">
          <garment-item
            wx:for="{{myTemplates}}"
            wx:key="id"
            data="{{item}}"
            selected="{{manageMode ? item.del : item.selected}}"
            bindtap="onItemTap"
            bind:longpress="onLongPress"
          />
        </view>

        <view class="sec-hd">
          <text class="sec-title">我的衣物</text>
          <text class="hint">上传的衣物 · 长按可删除</text>
        </view>
        <view wx:if="{{myGarments.length === 0}}" class="cat-empty">还没有上传衣物，切换到「上传」页添加</view>
        <view class="garment-grid">
          <garment-item
            wx:for="{{myGarments}}"
            wx:key="id"
            editable="{{true}}"
            data="{{item}}"
            selected="{{item.selected}}"
            bindtap="onMyGarmentTap"
            bind:longpress="onMyGarmentLongPress"
            bind:edit="openEditSheet"
          />
        </view>
      </block>

      <!-- 分类内选择衣物 -->
      <block wx:if="{{viewMode === 'select'}}">
        <view class="select-head">
          <view class="back-link" hover-class="back-hover" bindtap="backHome">‹ 返回</view>
          <text class="select-title">选择「{{curCategory}}」衣物</text>
        </view>
        <view class="hint">{{libManageMode ? '勾选要删除的模板衣物' : '点选衣物加入穿搭'}}</view>
        <view class="cat-tabs">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-tab {{curCategory === item ? 'on' : ''}}"
            hover-class="cat-tab-hover"
            data-cat="{{item}}"
            bindtap="onCategoryTab"
          >{{item}}</view>
        </view>
        <view wx:if="{{libItems.length === 0}}" class="cat-empty">该分类暂无衣物</view>
        <view class="garment-grid">
          <garment-item
            wx:for="{{libItems}}"
            wx:key="id"
            data="{{item}}"
            selected="{{item.selected}}"
            bindtap="onLibSelect"
          />
        </view>
      </block>
    </block>

    <!-- 上传衣物（切换到此 Tab 直接唤起上传弹层，无需额外按钮） -->
    <view wx:if="{{tab === 'upload'}}" class="upload-view">
      <view class="hint">上传衣物将自动加入衣物库，可在分类中选择加入模板</view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view wx:if="{{tab === 'lib' && viewMode === 'home' && !manageMode}}" class="footer-bar">
    <btn class="footer-main" type="primary" disabled="{{selectedCount === 0}}" bindtap="startTryon">{{buttonText}}</btn>
  </view>
  <view wx:if="{{tab === 'lib' && viewMode === 'home' && manageMode}}" class="delete-bar">
    <btn class="delete-bar-btn" type="secondary" size="sm" bindtap="toggleManage">取消</btn>
    <btn class="delete-btn-sm" type="danger" size="sm" bindtap="onDelete">
      删除（{{delCount}}）
    </btn>
  </view>
  <view wx:if="{{tab === 'lib' && viewMode === 'select'}}" class="footer-bar">
    <btn wx:if="{{!libManageMode}}" class="footer-main" type="primary" disabled="{{libSelectedCount === 0}}" bindtap="confirmAdd">加入穿搭（{{libSelectedCount}}）</btn>
    <btn wx:if="{{libManageMode}}" class="delete-bar-btn" type="secondary" size="sm" bindtap="toggleLibManage">取消</btn>
    <btn wx:if="{{libManageMode}}" class="delete-btn-sm" type="danger" size="sm" bindtap="confirmDelLib">
      删除（{{libDelCount}}）
    </btn>
  </view>

  <sheet visible="{{uploadVisible}}" bind:cancel="closeUpload">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">上传衣物</text>
      <text class="sheet-desc">拍照或从相册选择；jpg / png ≤ 20MB，非衣物图片将被拦截。</text>
    </view>
    <view class="pick-actions">
      <view class="pick-btn" hover-class="pick-hover" data-mode="album" bindtap="pickPhoto">
        <image class="ic-img" style="width:44rpx;height:44rpx" src="/assets/icons/png/icon-photo-deep.png" />
        <text>从相册选择</text>
      </view>
      <view class="pick-btn" hover-class="pick-hover" data-mode="camera" bindtap="pickPhoto">
        <image class="ic-img" style="width:44rpx;height:44rpx" src="/assets/icons/png/icon-camera-deep.png" />
        <text>拍照</text>
      </view>
    </view>
  </sheet>

  <sheet visible="{{infoVisible}}" bind:cancel="closeInfo">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">上传衣物信息</text>
      <text class="sheet-desc">填写衣物名称并选择分类，保存到衣物库</text>
    </view>
    <view class="info-form">
      <view class="info-field">
        <text class="info-label">衣物名称</text>
        <input class="info-input" value="{{uploadName}}" bindinput="onInfoName" placeholder="如：蓝色衬衫" maxlength="20" />
      </view>
      <view class="info-field">
        <text class="info-label">衣物分类</text>
        <view class="cat-grid">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-chip {{uploadCategory === item ? 'on' : ''}}"
            hover-class="cat-chip-hover"
            data-cat="{{item}}"
            bindtap="onInfoCategory"
          >{{item}}</view>
        </view>
      </view>
    </view>
    <view slot="actions" class="upload-actions">
      <btn class="upload-action-btn" type="primary" bindtap="confirmUpload">保存并预览</btn>
      <btn class="upload-action-btn" type="secondary" bindtap="closeInfo">取消</btn>
    </view>
  </sheet>

  <sheet visible="{{editVisible}}" bind:cancel="closeEditSheet">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">编辑衣物</text>
      <text class="sheet-desc">{{editingGarment.name}}</text>
    </view>
    <view class="edit-form">
      <view class="edit-field">
        <text class="edit-label">衣物名称</text>
        <input class="edit-input" value="{{editName}}" bindinput="onEditName" placeholder="衣物名称" maxlength="20" />
      </view>
      <view class="edit-field">
        <text class="edit-label">衣物分类</text>
        <view class="cat-grid">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-chip {{editCategory === item ? 'on' : ''}}"
            hover-class="cat-chip-hover"
            data-cat="{{item}}"
            bindtap="onEditCategory"
          >{{item}}</view>
        </view>
      </view>
      <view class="edit-field">
        <view class="edit-label-row">
          <text class="edit-label">尺码</text>
          <text class="edit-hint">选填</text>
        </view>
        <input class="edit-input" value="{{editSizeLabel}}" bindinput="onEditSizeLabel" placeholder="如：M / L / XL" maxlength="20" />
      </view>
      <view class="edit-field" wx:if="{{editCategory === '上衣'}}">
        <view class="edit-label-row">
          <text class="edit-label">实际尺寸（选填）</text>
          <text class="edit-help-btn" catchtap="showMeasureHelp">如何测量？</text>
        </view>
        <view class="measure-row">
          <view class="measure-item">
            <text class="measure-label">衣长</text>
            <view class="measure-input-wrap">
              <input class="measure-input" type="number" value="{{editLengthCm}}" bindinput="onEditLengthCm" placeholder="—" />
              <text class="measure-unit">cm</text>
            </view>
          </view>
          <view class="measure-item">
            <text class="measure-label">胸宽</text>
            <view class="measure-input-wrap">
              <input class="measure-input" type="number" value="{{editChestWidthCm}}" bindinput="onEditChestWidthCm" placeholder="—" />
              <text class="measure-unit">cm</text>
            </view>
          </view>
        </view>
        <view class="measure-row">
          <view class="measure-item">
            <text class="measure-label">肩宽</text>
            <view class="measure-input-wrap">
              <input class="measure-input" type="number" value="{{editShoulderWidthCm}}" bindinput="onEditShoulderWidthCm" placeholder="—" />
              <text class="measure-unit">cm</text>
            </view>
          </view>
          <view class="measure-item">
            <text class="measure-label">袖长</text>
            <view class="measure-input-wrap">
              <input class="measure-input" type="number" value="{{editSleeveLengthCm}}" bindinput="onEditSleeveLengthCm" placeholder="—" />
              <text class="measure-unit">cm</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view slot="actions" class="edit-actions">
      <btn class="edit-action-btn" type="primary" bindtap="saveEdit">保存</btn>
      <btn class="edit-action-btn" type="secondary" bindtap="closeEditSheet">取消</btn>
    </view>
  </sheet>

  <sheet visible="{{helpVisible}}" bind:cancel="closeMeasureHelp">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">如何测量？</text>
      <text class="sheet-desc">衣物平铺后测量，以下为各维度定义：</text>
    </view>
    <view class="help-list">
      <view class="help-item">
        <text class="help-term">衣长</text>
        <text class="help-desc">从肩部最高点到下摆</text>
      </view>
      <view class="help-item">
        <text class="help-term">胸宽</text>
        <text class="help-desc">腋下位置左右平量</text>
      </view>
      <view class="help-item">
        <text class="help-term">肩宽</text>
        <text class="help-desc">左右肩点之间</text>
      </view>
      <view class="help-item">
        <text class="help-term">袖长</text>
        <text class="help-desc">肩点到袖口</text>
      </view>
    </view>
    <view slot="actions" class="help-actions">
      <btn class="help-action-btn" type="primary" bindtap="closeMeasureHelp">知道了</btn>
    </view>
  </sheet>
</view>