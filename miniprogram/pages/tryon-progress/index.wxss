.wx-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; }

/* 布局：顶部偏中，内容自然填充，避免大片对称留白 */
.gen-layout { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx 40rpx; }

/* 脉冲圆点（提交阶段） */
.pulse-wrap { display: flex; align-items: center; justify-content: center; gap: 24rpx; margin-bottom: 64rpx; }
.pulse-dot { width: 24rpx; height: 24rpx; border-radius: 50%; background: var(--accent); opacity: 0.3; animation: pulse 1.2s ease-in-out infinite; }
.pulse-dot.d2 { animation-delay: 0.3s; }
.pulse-dot.d3 { animation-delay: 0.6s; }
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.6); opacity: 1; }
}

/* 进度圆环（缩小更精致） */
.ring-wrap { position: relative; width: 320rpx; height: 320rpx; margin-bottom: 56rpx; }
.ring { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(#E3A595 calc(var(--p) * 1%), #F0D6CC 0); transition: background 0.3s ease; }
.ring-hole { position: absolute; inset: 36rpx; border-radius: 50%; background: var(--bg); }
.ring-num { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 72rpx; font-weight: 700; color: var(--fg); }
.ring-num .pct { font-size: 36rpx; font-weight: 500; margin-left: 4rpx; color: var(--fg-2); }

/* 标题与副标题 */
.gen-title { text-align: center; font-size: 34rpx; font-weight: 600; }
.gen-sub { text-align: center; font-size: 27rpx; color: var(--fg-2); margin-top: 14rpx; line-height: 1.6; }

/* 阶段信息卡片 */
.gen-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; margin-top: 48rpx; width: 100%; }
.gen-card { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 28rpx; text-align: center; }
.gc-ic { width: 68rpx; height: 68rpx; border-radius: 20rpx; background: var(--accent-soft); display: flex; align-items: center; justify-content: center; margin: 0 auto 16rpx; }
.gc-ic .iconfont { font-size: 34rpx; }
.gc-label { font-size: 24rpx; color: var(--fg-2); }
.gc-val { font-size: 30rpx; font-weight: 600; margin-top: 6rpx; }

/* 底部提示 */
.hint { font-size: 25rpx; color: var(--fg-2); line-height: 1.65; }
.center { text-align: center; }
.mt-20 { margin-top: 40rpx; }
