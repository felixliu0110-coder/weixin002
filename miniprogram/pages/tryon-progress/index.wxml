<view class="wx-page">
  <nav-bar title="试穿生成中" showBack="{{true}}"></nav-bar>

  <view class="content big-hero-center">
    <!-- 提交任务阶段：显示 loading 而非进度环 -->
    <block wx:if="{{submitting && !error}}">
      <view class="ring-wrap">
        <view class="ring" style="--p: 0;"></view>
        <view class="ring-hole"></view>
        <view class="ring-num mono">...</view>
      </view>
      <view class="gen-title">正在提交任务...</view>
      <view class="gen-sub">AI 预处理衣物视图并创建生成任务</view>
      <view class="hint center mt-20">请稍候，即将开始生成</view>
    </block>

    <!-- 正常轮询阶段 -->
    <block wx:if="{{!submitting && !error}}">
      <view class="ring-wrap">
        <view class="ring" style="--p: {{percent}};"></view>
        <view class="ring-hole"></view>
        <view class="ring-num mono">{{percent}}%</view>
      </view>
      <view class="gen-title">正在为你试穿{{garmentName}}...</view>
      <view class="gen-sub">AI 三视图 + 衣物四视图 → 180° 转身视频</view>

      <view class="gen-cards">
        <view class="gen-card">
          <view class="gc-ic"><image class="ic-img" style="width:34rpx;height:34rpx" src="/assets/icons/png/icon-star-deep.png" /></view>
          <view class="gc-label">当前阶段</view>
          <view class="gc-val">{{stageText}}</view>
        </view>
        <view class="gen-card">
          <view class="gc-ic"><image class="ic-img" style="width:34rpx;height:34rpx" src="/assets/icons/png/icon-clock-deep.png" /></view>
          <view class="gc-label">预计耗时</view>
          <view class="gc-val">15 秒（示例）</view>
        </view>
      </view>

      <view class="hint center mt-20">生成完成后将通过微信消息通知你</view>
    </block>

    <!-- 失败态 -->
    <block wx:if="{{error}}">
      <view class="gen-title">生成失败</view>
      <view class="gen-sub">{{errorMsg || '生成异常，请重试'}}</view>
      <view class="err-actions">
        <btn class="retry-btn" type="primary" bindtap="retry">重新生成</btn>
        <btn class="back-btn" bindtap="backToSelect">返回重选衣物</btn>
      </view>
    </block>
  </view>

  <tab-bar selected="{{1}}" navMode="{{true}}"></tab-bar>
</view>
