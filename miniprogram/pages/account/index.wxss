.wx-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; }
.account-head { display: flex; align-items: center; gap: 28rpx; padding: 36rpx 4rpx 40rpx; }
.account-avatar { flex: 0 0 128rpx; width: 128rpx; height: 128rpx; border-radius: 50%; background: var(--accent-tab); color: var(--accent-on); font-size: 52rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.account-info { flex: 1; min-width: 0; }
.account-name { font-size: 38rpx; font-weight: 700; }
.account-id { font-size: 24rpx; color: var(--fg-2); margin-top: 10rpx; }
.row-tag { font-size: 26rpx; font-weight: 600; }
.logout-btn { display: block; margin-top: 64rpx; width: 90%; margin-left: auto; margin-right: auto; }
