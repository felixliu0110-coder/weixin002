.wx-page { min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); }
.footer-half { display: block; flex: 1; }
.card-gap { display: block; margin-top: 48rpx; }
.num-card { padding: 18rpx 12rpx 14rpx; }
.num-card .nc-name { font-size: 23rpx; }
.num-card .nc-val { font-size: 32rpx; }
.num-card .nc-step { margin-top: 8rpx; gap: 6rpx; }
.num-card .nc-step .step-btn { width: 48rpx; height: 48rpx; }
.num-card .nc-step .iconfont { font-size: 24rpx; }
.sec-title { font-size: 34rpx; font-weight: 600; color: var(--fg); }
.hint { font-size: 24rpx; color: var(--fg-2); }
.label { font-size: 28rpx; color: var(--fg-2); }
.val { font-size: 36rpx; font-weight: 700; color: var(--fg); }
.val .unit { font-size: 26rpx; font-weight: 500; color: var(--fg-2); margin-left: 4rpx; }
.nc-val .unit { font-size: 22rpx; font-weight: 500; color: var(--fg-2); }
.step-hover { background: var(--accent-soft); border-color: var(--accent); }
.chip-row .chip { min-width: 0; }
.opt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.opt-card { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 20rpx 20rpx 16rpx; display: flex; flex-direction: column; gap: 6rpx; box-shadow: var(--shadow-card); }
.opt-hover { border-color: var(--accent); }
.opt-label { font-size: 24rpx; color: var(--fg-2); }
.opt-val { font-size: 30rpx; font-weight: 700; color: var(--fg); }
.opt-unit { font-size: 22rpx; font-weight: 500; color: var(--fg-2); margin-left: 4rpx; }
.opt-edit { font-size: 22rpx; color: #7A5A4E; }
.sheet-head { display: flex; flex-direction: column; gap: 8rpx; }
.grab { width: 80rpx; height: 8rpx; border-radius: 4rpx; background: var(--border); margin: 0 auto 20rpx; }
.sheet-title { font-size: 34rpx; font-weight: 600; }
.edit-body { margin-top: 28rpx; }
.edit-val { font-size: 44rpx; font-weight: 700; color: var(--fg); }
.sheet-action { display: block; flex: 1; }
slider { width: 100%; }
slider.skin-range .wx-slider-track { background: linear-gradient(to right, #FFF0E4, #5C3A28); }
