<view class="wx-page">
  <nav-bar title="今日穿搭灵感" showBack="{{true}}"></nav-bar>

  <view class="content">
    <view class="photo-card">
      <image src="/assets/img/p07-result.jpg" mode="widthFix" />
      <view class="badge-ai"><image class="ic-img" style="width:24rpx;height:24rpx" src="/assets/icons/png/icon-star-white.png" />AI 生成</view>
      <view class="wm">AI 生成效果，仅供参考</view>
    </view>

    <view class="angle-row">
      <chip label="正面" selected="{{angle === '正面'}}" bindchange="onAngle" />
      <chip label="侧面" selected="{{angle === '侧面'}}" bindchange="onAngle" />
      <chip label="背面" selected="{{angle === '背面'}}" bindchange="onAngle" />
    </view>

    <card class="result-meta">
      <view class="rm-copy">
        <view class="rm-title">粉色针织连衣裙</view>
        <view class="rm-sub">按你的身材（168cm / 55kg）生成，默认正面全身，可选侧面 / 背面。</view>
        <view class="rm-hint">尺码建议仅供参考</view>
      </view>
      <view class="rm-tag">建议 M</view>
    </card>

    <view class="action-row">
      <btn class="action-btn" type="secondary" bindtap="onCollect"><image class="ic-img" style="width:32rpx;height:32rpx" src="/assets/icons/png/icon-heart-gray.png" />收藏</btn>
      <btn class="action-btn" type="secondary" bindtap="onSaveTemplate"><image class="ic-img" style="width:32rpx;height:32rpx" src="/assets/icons/png/icon-hanger-gray.png" />存模板</btn>
      <btn class="action-btn" type="dark" bindtap="onShare"><image class="ic-img" style="width:32rpx;height:32rpx" src="/assets/icons/png/icon-upload-white.png" />分享</btn>
    </view>
  </view>

  <tab-bar selected="{{1}}" navMode="{{true}}"></tab-bar>

  <sheet visible="{{collectVisible}}" bind:cancel="closeCollect">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">收藏成功</text>
      <text class="sheet-desc">是否同时保存到相册？</text>
    </view>
    <view slot="actions">
      <view class="collect-actions">
        <btn class="collect-btn" type="primary" bindtap="collectYes">是，保存到相册</btn>
        <btn class="collect-btn" type="secondary" bindtap="collectNo">否，仅收藏</btn>
      </view>
    </view>
  </sheet>

  <sheet visible="{{templateVisible}}" bind:cancel="closeTemplate">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">保存到模板衣物</text>
    </view>
    <view class="tpl-form">
      <view class="tpl-field">
        <text class="tpl-label">衣物名称</text>
        <input class="tpl-input" value="{{tplName}}" bindinput="onTplName" placeholder="输入衣物名称" maxlength="20" />
      </view>
      <view class="tpl-field">
        <text class="tpl-label">衣物分类</text>
        <view class="cat-grid">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-chip {{tplCategory === item ? 'on' : ''}}"
            hover-class="cat-chip-hover"
            data-cat="{{item}}"
            bindtap="onTplCategory"
          >{{item}}</view>
        </view>
      </view>
    </view>
    <view slot="actions">
      <btn class="sheet-action" type="secondary" bindtap="closeTemplate">取消</btn>
      <btn class="sheet-action" type="primary" bindtap="confirmSaveTemplate">保存</btn>
    </view>
  </sheet>
</view>
