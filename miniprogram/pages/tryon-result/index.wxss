.wx-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; }
.photo-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-soft); background: var(--surface); box-shadow: var(--shadow-card); }
.photo-card image { width: 100%; }
.badge-ai { position: absolute; top: 24rpx; left: 24rpx; background: rgba(31,29,27,0.76); color: var(--accent-on); font-size: 22rpx; font-weight: 500; padding: 10rpx 20rpx; border-radius: 999rpx; display: inline-flex; align-items: center; gap: 10rpx; }
.badge-ai .iconfont { font-size: 24rpx; }
.wm { position: absolute; left: 50%; bottom: 24rpx; transform: translateX(-50%); background: rgba(31,29,27,0.66); color: rgba(255,255,255,0.92); font-size: 21rpx; padding: 8rpx 24rpx; border-radius: 999rpx; white-space: nowrap; }
.angle-row { display: flex; gap: 16rpx; margin-top: 28rpx; }
.angle-row .chip { flex: 1; }
.result-meta { display: block; margin-top: 28rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.rm-copy { flex: 1; min-width: 0; }
.rm-title { font-size: 34rpx; font-weight: 600; }
.rm-sub { font-size: 25rpx; color: var(--fg-2); margin-top: 8rpx; line-height: 1.55; }
.rm-hint { font-size: 24rpx; color: var(--fg-2); margin-top: 8rpx; }
.rm-tag { flex: 0 0 auto; background: var(--tag-bg); color: var(--fg-2); font-size: 24rpx; font-weight: 600; border-radius: 999rpx; padding: 10rpx 22rpx; }
.action-row { display: flex; gap: 20rpx; margin-top: 28rpx; }
.action-btn { display: block; flex: 1; }
.sheet-head { display: flex; flex-direction: column; gap: 8rpx; }
.grab { width: 80rpx; height: 8rpx; border-radius: 4rpx; background: var(--border); margin: 0 auto 20rpx; }
.sheet-title { font-size: 34rpx; font-weight: 600; }
.sheet-desc { font-size: 26rpx; color: var(--fg-2); line-height: 1.65; margin-top: 12rpx; }
.sheet-action { display: block; flex: 1; }
.collect-actions { display: flex; flex-direction: column; gap: 24rpx; }
.collect-btn { display: block; width: 100%; }
.template-options { display: flex; gap: 24rpx; margin: 32rpx 0 8rpx; }
.tpl-btn { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 104rpx; border-radius: var(--radius-md); background: var(--accent-soft); color: #7A5A4E; font-size: 30rpx; font-weight: 600; }
.tpl-hover { background: var(--accent-tab); }
.action-row .iconfont { font-size: 32rpx; margin-right: 8rpx; }
