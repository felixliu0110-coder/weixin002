.wx-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; }

/* 预览图片卡片 */
.preview-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-soft); background: var(--surface); box-shadow: var(--shadow-card); margin-bottom: 32rpx; }
.preview-img { width: 100%; height: 400rpx; display: block; }
.preview-badge { position: absolute; top: 20rpx; left: 20rpx; background: rgba(31,29,27,0.76); color: var(--accent-on); font-size: 22rpx; font-weight: 500; padding: 8rpx 18rpx; border-radius: 999rpx; }

/* 引导区域 */
.vg-intro { text-align: center; margin-bottom: 40rpx; }
.vg-intro-title { font-size: 34rpx; font-weight: 600; color: var(--fg); }
.vg-intro-desc { font-size: 26rpx; color: var(--fg-2); margin-top: 16rpx; line-height: 1.65; padding: 0 40rpx; }
.vg-intro-features { display: flex; justify-content: center; gap: 40rpx; margin-top: 32rpx; }
.vg-feature { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.vg-f-icon { width: 48rpx; height: 48rpx; }
.vg-f-text { font-size: 24rpx; color: var(--fg-2); }

/* 按钮 */
.vg-start-btn { margin-top: 20rpx; }
.vg-back-btn { margin-top: 20rpx; }
.vg-action-btn { margin-top: 16rpx; }

/* 进度环（复用 tryon-progress 样式） */
.ring-wrap { position: relative; width: 320rpx; height: 320rpx; margin: 0 auto 40rpx; }
.ring { width: 100%; height: 100%; border-radius: 50%; background: conic-gradient(var(--accent) calc(var(--p) * 1%), var(--border-soft) 0); }
.ring-hole { position: absolute; top: 24rpx; left: 24rpx; right: 24rpx; bottom: 24rpx; border-radius: 50%; background: var(--bg); }
.ring-num { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 64rpx; font-weight: 700; color: var(--fg); }
.gen-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 12rpx; }
.gen-sub { font-size: 26rpx; color: var(--fg-2); text-align: center; }
.hint { font-size: 24rpx; color: var(--fg-3); }
.center { text-align: center; }
.mt-20 { margin-top: 20rpx; }

/* 视频就绪区域 */
.video-ready { text-align: center; }
.video-ready-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.video-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; height: 400rpx; border: 1px solid var(--border-soft); margin-bottom: 32rpx; }
.video-poster { width: 100%; height: 100%; display: block; }
.video-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(0,0,0,0.25); }
.play-icon { width: 80rpx; height: 80rpx; }
.play-text { font-size: 28rpx; color: #fff; margin-top: 12rpx; font-weight: 500; text-shadow: 0 1px 4px rgba(0,0,0,0.3); }
.video-actions { display: flex; flex-direction: column; gap: 16rpx; }

/* 失败态 */
.err-actions { display: flex; flex-direction: column; gap: 20rpx; margin-top: 32rpx; }
.retry-btn, .back-btn { display: block; width: 100%; }

/* 视频播放器弹层 */
.video-player-wrap { padding: 20rpx 0; }
.result-video { width: 100%; border-radius: var(--radius-md); display: block; background: #000; }
