<view class="wx-page">
  <nav-bar title="360° 动态试穿" showBack="{{true}}"></nav-bar>

  <view class="content big-hero-center">
    <!-- 展示当前试穿图片 -->
    <view class="preview-card">
      <image class="preview-img" src="{{result.tryonImage}}" mode="aspectFill" />
      <view class="preview-badge">当前试穿效果</view>
    </view>

    <!-- 未生成：引导区域 -->
    <block wx:if="{{!generating && !videoUrl && !error}}">
      <view class="vg-intro">
        <view class="vg-intro-title">生成 180° 转身视频</view>
        <view class="vg-intro-desc">基于 AI 三视图与衣物四视图，生成动态转身效果，全方位查看穿搭细节</view>
        <view class="vg-intro-features">
          <view class="vg-feature">
            <image class="vg-f-icon" src="/assets/icons/svg/ic-play.svg" mode="aspectFit" />
            <text class="vg-f-text">180° 转身展示</text>
          </view>
          <view class="vg-feature">
            <image class="vg-f-icon" src="/assets/icons/svg/ic-hanger.svg" mode="aspectFit" />
            <text class="vg-f-text">动态穿搭细节</text>
          </view>
          <view class="vg-feature">
            <image class="vg-f-icon" src="/assets/icons/svg/ic-share.svg" mode="aspectFit" />
            <text class="vg-f-text">可保存分享</text>
          </view>
        </view>
      </view>
      <btn class="vg-start-btn" type="primary" bindtap="startGenerate">一键生成视频</btn>
      <btn class="vg-back-btn" type="secondary" bindtap="backToResult">返回结果页</btn>
    </block>

    <!-- 生成中：进度展示 -->
    <block wx:if="{{generating && !error}}">
      <view class="ring-wrap">
        <view class="ring" style="--p: {{percent}};"></view>
        <view class="ring-hole"></view>
        <view class="ring-num mono">{{percent}}%</view>
      </view>
      <view class="gen-title">正在生成 180° 转身视频...</view>
      <view class="gen-sub">{{stageText}}</view>
      <view class="hint center mt-20">预计耗时 15-30 秒，请稍候</view>
    </block>

    <!-- 生成完成：视频展示 -->
    <block wx:if="{{videoUrl && !generating && !error}}">
      <view class="video-ready">
        <view class="video-ready-title">视频生成完成</view>
        <view class="video-card" bindtap="playVideo">
          <image class="video-poster" src="{{result.tryonImage}}" mode="aspectFill" />
          <view class="video-overlay">
            <image class="play-icon" src="/assets/icons/svg/ic-play.svg" mode="aspectFit" />
            <text class="play-text">点击播放</text>
          </view>
        </view>
        <view class="video-actions">
          <btn class="vg-action-btn" type="primary" bindtap="playVideo">播放视频</btn>
          <btn class="vg-action-btn" type="secondary" bindtap="backToResult">返回结果页</btn>
        </view>
      </view>
    </block>

    <!-- 失败态 -->
    <block wx:if="{{error}}">
      <view class="gen-title">生成失败</view>
      <view class="gen-sub">{{errorMsg || '生成异常，请重试'}}</view>
      <view class="err-actions">
        <btn class="retry-btn" type="primary" bindtap="startGenerate">重新生成</btn>
        <btn class="back-btn" type="secondary" bindtap="backToResult">返回结果页</btn>
      </view>
    </block>
  </view>

  <tab-bar selected="{{1}}" navMode="{{true}}"></tab-bar>

  <!-- 视频播放弹层 -->
  <sheet visible="{{videoVisible}}" bind:cancel="closeVideo">
    <view class="video-player-wrap">
      <video
        class="result-video"
        src="{{videoUrl}}"
        controls
        objectFit="cover"
        poster="{{result.tryonImage}}"
        autoplay
      ></video>
    </view>
  </sheet>
</view>
