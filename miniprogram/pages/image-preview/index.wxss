.wx-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; }
.photo-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-soft); background: var(--surface); box-shadow: var(--shadow-card); }
.photo-card image { width: 100%; }
.badge-cut { position: absolute; left: 24rpx; bottom: 24rpx; background: var(--accent); color: var(--accent-on); font-size: 22rpx; font-weight: 600; padding: 10rpx 20rpx; border-radius: 999rpx; }
.sec-title { font-size: 34rpx; font-weight: 600; }
.hint { font-size: 24rpx; color: var(--fg-2); }
.chip-row { display: flex; gap: 16rpx; flex-wrap: wrap; }
.chip-row .chip { flex: 1; min-width: 0; }
.cat-result { display: flex; flex-direction: column; gap: 14rpx; align-items: flex-start; }
.rec-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 120rpx; height: 72rpx; padding: 0 32rpx; border-radius: 999rpx; background: var(--accent-soft); color: #7A5A4E; font-size: 28rpx; font-weight: 600; }
.cat-note { font-size: 24rpx; color: var(--fg-2); }
