<view class="wx-page">
  <nav-bar title="试穿记录" showBack="{{true}}" backRoute="/pages/profile/index">
    <view slot="right" class="manage-btn" hover-class="manage-hover" bindtap="toggleManage">{{manageMode ? '完成' : '管理'}}</view>
  </nav-bar>

  <view class="content">
    <view wx:if="{{records.length === 0}}" class="empty-state">
      <view class="es-ic"><image class="ic-img" style="width:40rpx;height:40rpx" src="/assets/icons/png/icon-heart-gray.png" /></view>
      <text class="es-text">暂无试穿记录，去试试第一件吧</text>
    </view>

    <view wx:else class="masonry">
      <record-item
        wx:for="{{records}}"
        wx:key="id"
        data="{{item}}"
        selected="{{manageMode && delSelected.includes(item.id)}}"
        bindtap="onItemTap"
        bind:longpress="onLongPress"
      />
    </view>

    <view class="hint center mt-16">以上为 AI 生成效果，仅供参考</view>
  </view>

  <view wx:if="{{manageMode}}" class="delete-bar">
    <btn class="footer-main" type="danger" disabled="{{delSelected.length === 0}}" bindtap="onDelete">删除（{{delSelected.length}}）</btn>
  </view>

  <tab-bar selected="{{3}}" navMode="{{true}}"></tab-bar>
</view>
