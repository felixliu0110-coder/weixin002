<view class="wx-page">
  <nav-bar title="试穿记录" showBack="{{true}}" backRoute="/pages/profile/index"></nav-bar>

  <view class="content">
    <view class="subtitle">选择一件衣服，先看上身效果。</view>

    <view wx:if="{{records.length === 0}}" class="empty-state">
      <view class="es-ic"><text class="iconfont icon-heart"></text></view>
      <text class="es-text">暂无试穿记录，去试试第一件吧</text>
    </view>

    <view wx:else class="masonry">
      <record-item
        wx:for="{{records}}"
        wx:key="id"
        data="{{item}}"
        bindtap="openResult"
      />
    </view>

    <view class="hint center mt-16">以上为 AI 生成效果，仅供参考</view>
  </view>
</view>
