.auth-page { position: fixed; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 56rpx 44rpx; background: radial-gradient(120% 80% at 50% 0%, #FCF0EA, transparent 62%), var(--bg); }
.auth-card { width: 100%; background: var(--surface); border-radius: 48rpx; padding: 52rpx 44rpx 44rpx; box-shadow: var(--shadow-raise); border: 1px solid var(--border-soft); }
.auth-title { font-size: 38rpx; font-weight: 700; text-align: center; }
.auth-list { margin-top: 36rpx; }
.auth-item { display: flex; gap: 20rpx; align-items: flex-start; padding: 18rpx 4rpx; font-size: 27rpx; line-height: 1.65; color: var(--fg-2); }
.dot { flex: 0 0 16rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--accent); margin-top: 14rpx; }
.auth-actions { display: flex; gap: 20rpx; margin-top: 44rpx; }
.auth-actions .btn { flex: 1; }
