.wx-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; }
.nav-btn { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); color: var(--fg); transition: background 0.15s ease; }
.nav-btn-hover { background: var(--surface-2); }
.nav-btn .iconfont { font-size: 42rpx; }
.content { flex: 1; overflow-y: auto; padding: 8rpx 24rpx 48rpx; }
.privacy-card { padding: 40rpx 36rpx; }
.privacy-icon { width: 96rpx; height: 96rpx; border-radius: var(--radius-md); background: var(--accent-soft); color: var(--accent-text); display: flex; align-items: center; justify-content: center; margin-bottom: 28rpx; }
.privacy-icon .iconfont { font-size: 48rpx; }
.privacy-title { font-size: 36rpx; font-weight: 700; margin-bottom: 16rpx; }
.privacy-desc { font-size: 28rpx; color: var(--fg-2); line-height: 1.7; }
.privacy-items { margin-top: 36rpx; display: flex; flex-direction: column; gap: 20rpx; }
.privacy-item { display: flex; align-items: flex-start; gap: 16rpx; padding: 24rpx 28rpx; border-radius: var(--radius-md); background: var(--surface); border: 1rpx solid var(--border-soft); }
.privacy-item .iconfont { font-size: 32rpx; color: var(--accent-text); margin-top: 4rpx; flex-shrink: 0; }
.privacy-item-text { font-size: 28rpx; color: var(--fg); line-height: 1.6; }
.privacy-actions { margin-top: 48rpx; display: flex; flex-direction: column; gap: 20rpx; }
.privacy-actions .btn { width: 100%; }
