<view class="auth-page" data-mask="1" bindtap="onMaskTap">
  <view class="auth-card" data-card="1">
    <view class="auth-title">隐私授权说明</view>
    <view class="auth-list">
      <view class="auth-item"><view class="dot"></view><text>人脸照片仅用于数字人头部重建，不会用于其他用途</text></view>
      <view class="auth-item"><view class="dot"></view><text>身体数据加密存储（AES-256），可随时删除</text></view>
      <view class="auth-item"><view class="dot"></view><text>照片与数据不用于任何第三方模型训练</text></view>
    </view>
    <view class="auth-actions">
      <btn type="secondary" bindtap="onDecline">不同意</btn>
      <btn type="primary" bindtap="onAccept">同意并继续</btn>
    </view>
  </view>
</view>
