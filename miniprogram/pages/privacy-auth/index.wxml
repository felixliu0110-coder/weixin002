<view class="wx-page auth-page">
  <nav-bar title="隐私授权" showBack="{{true}}"></nav-bar>
  <view class="auth-body">
    <view class="auth-card">
      <view class="auth-title">隐私授权说明</view>
      <view class="auth-list">
        <view class="auth-item"><view class="dot"></view><text>人物照片仅用于建立 Person Asset 与试穿，不会用于其他用途</text></view>
        <view class="auth-item"><view class="dot"></view><text>身体数据用于人物基准与试穿相关功能，可在隐私管理中删除</text></view>
        <view class="auth-item"><view class="dot"></view><text>照片与数据不用于任何第三方模型训练</text></view>
      </view>
      <view class="auth-actions">
        <button class="auth-btn secondary" hover-class="auth-btn-hover" bindtap="onDecline">不同意</button>
        <button class="auth-btn" hover-class="auth-btn-hover" bindtap="onAccept">同意并继续</button>
      </view>
    </view>
  </view>
</view>
