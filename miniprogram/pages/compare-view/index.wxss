.wx-page { min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); }
.compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28rpx; }
.hint { font-size: 25rpx; color: var(--fg-2); line-height: 1.65; }
.center { text-align: center; }
.mt-16 { margin-top: 32rpx; }
.action-row { display: flex; gap: 20rpx; margin-top: 28rpx; }
.action-btn { flex: 1; }
