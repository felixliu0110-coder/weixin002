.wx-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; }
.nav-btn { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-sm); color: var(--fg); transition: background 0.15s ease; }
.nav-btn-hover { background: var(--surface-2); }
.nav-btn .iconfont { font-size: 42rpx; }
.content { flex: 1; overflow-y: auto; padding: 8rpx 0 48rpx; }
.compare-container { display: flex; flex-direction: column; gap: 24rpx; }
.compare-card { border-radius: var(--radius-lg); overflow: hidden; border: 1rpx solid var(--border-soft); background: var(--surface); box-shadow: var(--shadow-card); }
.compare-card image { width: 100%; height: 480rpx; }
.compare-label { padding: 20rpx 28rpx; font-size: 28rpx; font-weight: 600; text-align: center; }
.compare-label.before { background: var(--surface-2); color: var(--fg-2); }
.compare-label.after { background: var(--accent-soft); color: var(--accent-deep); }
.compare-actions { margin-top: 32rpx; display: flex; gap: 20rpx; }
.compare-actions .btn { flex: 1; }
