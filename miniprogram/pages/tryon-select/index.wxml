<view class="wx-page">
  <nav-bar title="选择衣物" showBack="{{true}}" backRoute="/pages/home/index">
    <view slot="right" class="manage-btn" hover-class="manage-hover" bindtap="toggleManage">{{manageMode ? '完成' : '管理'}}</view>
  </nav-bar>

  <view class="content">
    <seg options="{{tabs}}" value="{{tab}}" bindchange="onTab" />

    <view class="hint">选择一件衣物，AI 将按你的数字人体型生成试穿效果。</view>

    <view wx:if="{{templates.length === 0 && !manageMode}}" class="empty-state">
      <view class="es-ic"><image class="ic-img" style="width:40rpx;height:40rpx" src="/assets/icons/png/icon-hanger-gray.png" /></view>
      <text class="es-text">暂无模板衣物，试试上传一件</text>
      <btn class="empty-btn" type="secondary" size="sm" bindtap="openUpload">上传衣物</btn>
    </view>

    <view class="garment-grid">
      <garment-item
        wx:for="{{templates}}"
        wx:key="id"
        data="{{item}}"
        selected="{{manageMode ? item.del : item.selected}}"
        bindtap="onItemTap"
      />
    </view>
  </view>

  <view class="footer-bar">
    <btn class="footer-main" type="primary" disabled="{{selectedCount === 0}}" bindtap="startTryon">{{buttonText}}</btn>
  </view>

  <view wx:if="{{manageMode}}" class="delete-bar">
    <btn class="footer-main" type="danger" disabled="{{delCount === 0}}" bindtap="onDelete">删除（{{delCount}}）</btn>
  </view>

  <sheet visible="{{uploadVisible}}" bind:cancel="closeUpload">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">上传衣物</text>
      <text class="sheet-desc">拍照或从相册选择，AI 自动识别品类并抠图；jpg / png ≤ 20MB，非衣物图片将被拦截。</text>
    </view>
    <view class="pick-actions">
      <view class="pick-btn" hover-class="pick-hover" data-mode="album" bindtap="pickPhoto">
        <image class="ic-img" style="width:44rpx;height:44rpx" src="/assets/icons/png/icon-photo-deep.png" />
        <text>从相册选择</text>
      </view>
      <view class="pick-btn" hover-class="pick-hover" data-mode="camera" bindtap="pickPhoto">
        <image class="ic-img" style="width:44rpx;height:44rpx" src="/assets/icons/png/icon-camera-deep.png" />
        <text>拍照</text>
      </view>
    </view>
  </sheet>
</view>
