<view class="wx-page">
  <nav-bar title="选择衣物" showBack="{{true}}" backRoute="/pages/home/index">
    <view wx:if="{{tab === 'lib' && viewMode === 'home'}}" slot="right" class="manage-btn" hover-class="manage-hover" bindtap="toggleManage">{{manageMode ? '完成' : '管理'}}</view>
    <view wx:if="{{tab === 'lib' && viewMode === 'select'}}" slot="right" class="manage-btn" hover-class="manage-hover" bindtap="toggleLibManage">{{libManageMode ? '完成' : '管理'}}</view>
  </nav-bar>

  <view class="content">
    <seg options="{{tabs}}" value="{{tab}}" bindchange="onTab" />

    <!-- 模板衣物 -->
    <block wx:if="{{tab === 'lib'}}">
      <!-- 分类入口 + 我的模板 -->
      <block wx:if="{{viewMode === 'home'}}">
        <view class="hint">点击分类选择衣物，加入下面的「已选穿搭」</view>
        <view class="cat-cards">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-card"
            hover-class="cat-card-hover"
            data-cat="{{item}}"
            bindtap="onCatCard"
          >
            <text class="cat-emoji">{{catEmojis[item]}}</text>
            <text class="cat-name">{{item}}</text>
            <text class="cat-count">{{catCounts[item] || 0}} 件</text>
          </view>
        </view>

        <view class="sec-hd">
          <text class="sec-title">已选穿搭衣物</text>
          <text class="hint">长按可删除</text>
        </view>
        <view wx:if="{{myTemplates.length === 0 && !manageMode}}" class="cat-empty">还没选择衣物，点击上方分类挑选</view>
        <view class="garment-grid">
          <garment-item
            wx:for="{{myTemplates}}"
            wx:key="id"
            data="{{item}}"
            selected="{{manageMode ? item.del : item.selected}}"
            bindtap="onItemTap"
            bind:longpress="onLongPress"
          />
        </view>
      </block>

      <!-- 分类内选择衣物 -->
      <block wx:if="{{viewMode === 'select'}}">
        <view class="select-head">
          <view class="back-link" hover-class="back-hover" bindtap="backHome">‹ 返回</view>
          <text class="select-title">选择「{{curCategory}}」衣物</text>
        </view>
        <view class="hint">{{libManageMode ? '勾选要删除的模板衣物' : '点选衣物加入穿搭'}}</view>
        <view class="cat-tabs">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-tab {{curCategory === item ? 'on' : ''}}"
            hover-class="cat-tab-hover"
            data-cat="{{item}}"
            bindtap="onCategoryTab"
          >{{item}}</view>
        </view>
        <view wx:if="{{libItems.length === 0}}" class="cat-empty">该分类暂无衣物</view>
        <view class="garment-grid">
          <garment-item
            wx:for="{{libItems}}"
            wx:key="id"
            data="{{item}}"
            selected="{{item.selected}}"
            bindtap="onLibSelect"
          />
        </view>
      </block>
    </block>

    <!-- 上传衣物 -->
    <view wx:if="{{tab === 'upload'}}" class="upload-view">
      <view class="hint">上传衣物将自动加入衣物库，可在分类中选择加入模板</view>
      <btn class="empty-btn" type="secondary" size="sm" bindtap="openUpload">上传衣物</btn>
    </view>
  </view>

  <!-- 底部操作 -->
  <view wx:if="{{tab === 'lib' && viewMode === 'home' && !manageMode}}" class="footer-bar">
    <btn class="footer-main" type="primary" disabled="{{selectedCount === 0}}" bindtap="startTryon">{{buttonText}}</btn>
  </view>
  <view wx:if="{{tab === 'lib' && viewMode === 'home' && manageMode}}" class="delete-bar">
    <btn class="delete-btn" type="danger" disabled="{{delCount === 0}}" bindtap="onDelete">
      <image class="ic-img" style="width:32rpx;height:32rpx" src="/assets/icons/png/icon-trash-white.png" />删除所选（{{delCount}}）
    </btn>
  </view>
  <view wx:if="{{tab === 'lib' && viewMode === 'select'}}" class="footer-bar">
    <btn wx:if="{{!libManageMode}}" class="footer-main" type="primary" disabled="{{libSelectedCount === 0}}" bindtap="confirmAdd">加入穿搭（{{libSelectedCount}}）</btn>
    <btn wx:if="{{libManageMode}}" class="delete-btn" type="danger" disabled="{{libDelCount === 0}}" bindtap="confirmDelLib">
      <image class="ic-img" style="width:32rpx;height:32rpx" src="/assets/icons/png/icon-trash-white.png" />删除所选（{{libDelCount}}）
    </btn>
  </view>

  <sheet visible="{{uploadVisible}}" bind:cancel="closeUpload">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">上传衣物</text>
      <text class="sheet-desc">拍照或从相册选择；jpg / png ≤ 20MB，非衣物图片将被拦截。</text>
    </view>
    <view class="pick-actions">
      <view class="pick-btn" hover-class="pick-hover" data-mode="album" bindtap="pickPhoto">
        <image class="ic-img" style="width:44rpx;height:44rpx" src="/assets/icons/png/icon-photo-deep.png" />
        <text>从相册选择</text>
      </view>
      <view class="pick-btn" hover-class="pick-hover" data-mode="camera" bindtap="pickPhoto">
        <image class="ic-img" style="width:44rpx;height:44rpx" src="/assets/icons/png/icon-camera-deep.png" />
        <text>拍照</text>
      </view>
    </view>
  </sheet>

  <sheet visible="{{infoVisible}}" bind:cancel="closeInfo">
    <view class="sheet-head">
      <view class="grab"></view>
      <text class="sheet-title">上传衣物信息</text>
      <text class="sheet-desc">填写衣物名称并选择分类，保存到衣物库</text>
    </view>
    <view class="info-form">
      <view class="info-field">
        <text class="info-label">衣物名称</text>
        <input class="info-input" value="{{uploadName}}" bindinput="onInfoName" placeholder="如：蓝色衬衫" maxlength="20" />
      </view>
      <view class="info-field">
        <text class="info-label">衣物分类</text>
        <view class="cat-grid">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="cat-chip {{uploadCategory === item ? 'on' : ''}}"
            hover-class="cat-chip-hover"
            data-cat="{{item}}"
            bindtap="onInfoCategory"
          >{{item}}</view>
        </view>
      </view>
    </view>
    <view slot="actions" class="upload-actions">
      <btn class="upload-action-btn" type="primary" bindtap="confirmUpload">保存并预览</btn>
      <btn class="upload-action-btn" type="secondary" bindtap="closeInfo">取消</btn>
    </view>
  </sheet>
</view>
