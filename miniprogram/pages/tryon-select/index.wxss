.wx-page { height: 100vh; display: flex; flex-direction: column; background: var(--bg); overflow: hidden; padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom)); }
.manage-btn { font-size: 26rpx; color: #7A5A4E; padding: 10rpx 16rpx; }
.manage-hover { opacity: 0.8; }
.delete-bar { flex: 0 0 auto; padding: 20rpx 0 calc(20rpx + env(safe-area-inset-bottom)); background: var(--bg); border-top: 1px solid var(--border-soft); display: flex; justify-content: center; }
.delete-btn-sm { display: inline-flex; align-items: center; justify-content: center; gap: 8rpx; width: auto; min-width: 200rpx; padding: 0 28rpx; }
.cat-tabs { display: flex; gap: 16rpx; margin-bottom: 32rpx; flex-wrap: wrap; }
.cat-tab { display: inline-flex; align-items: center; justify-content: center; min-height: 72rpx; padding: 0 30rpx; border-radius: 999rpx; border: 1px solid var(--border); background: var(--surface); color: var(--fg-2); font-size: 26rpx; }
.cat-tab.on { background: var(--accent); border-color: var(--accent); color: var(--accent-on); font-weight: 600; }
.cat-tab-hover { opacity: 0.85; }
.cat-empty { display: flex; align-items: center; justify-content: center; padding: 60rpx 0; color: var(--fg-2); font-size: 26rpx; }
.cat-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; margin-top: 8rpx; }
.cat-card { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 28rpx 12rpx 22rpx; border-radius: var(--radius-lg); background: linear-gradient(180deg, var(--accent-soft), #FDF3EE); border: 1px solid var(--border-soft); box-shadow: var(--shadow-card); }
.cat-card-hover { transform: scale(0.97); border-color: var(--accent); }
.cat-emoji { font-size: 52rpx; line-height: 1; }
.cat-name { font-size: 28rpx; font-weight: 600; color: var(--fg); }
.cat-count { font-size: 22rpx; color: var(--fg-2); }
.select-head { display: flex; align-items: center; gap: 20rpx; margin: 8rpx 2rpx 24rpx; }
.back-link { font-size: 34rpx; font-weight: 600; color: #5A4138; padding: 8rpx 4rpx; }
.back-hover { opacity: 0.8; }
.select-title { font-size: 32rpx; font-weight: 600; }
.upload-view { display: flex; flex-direction: column; align-items: center; gap: 28rpx; padding: 60rpx 0; text-align: center; }
.empty-btn { display: block; width: auto; }
.hint { font-size: 25rpx; color: var(--fg-2); margin: 20rpx 4rpx 24rpx; }
.garment-grid { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 24rpx; row-gap: 52rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; gap: 20rpx; padding: 68rpx 32rpx; text-align: center; }
.es-ic { width: 84rpx; height: 84rpx; border-radius: 28rpx; background: var(--surface-2); color: var(--fg-2); display: flex; align-items: center; justify-content: center; }
.es-ic .iconfont { font-size: 40rpx; }
.es-text { font-size: 26rpx; color: var(--fg-2); }
.sheet-head { display: flex; flex-direction: column; gap: 8rpx; }
.grab { width: 80rpx; height: 8rpx; border-radius: 4rpx; background: var(--border); margin: 0 auto 20rpx; }
.sheet-title { font-size: 34rpx; font-weight: 600; }
.sheet-desc { font-size: 26rpx; color: var(--fg-2); line-height: 1.65; margin-top: 12rpx; }
.pick-actions { display: flex; gap: 24rpx; margin: 36rpx 0 8rpx; }
.pick-btn { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 40rpx 0 36rpx; border-radius: var(--radius-md); background: var(--accent-soft); color: #7A5A4E; font-size: 28rpx; font-weight: 600; }
.pick-hover { background: var(--accent-tab); }
.info-form { margin-top: 28rpx; }
.info-field { margin-top: 24rpx; }
.info-label { font-size: 26rpx; color: var(--fg-2); display: block; margin-bottom: 12rpx; }
.info-input { border: 1px solid var(--border); background: var(--surface); border-radius: var(--radius-md); height: 84rpx; padding: 0 24rpx; font-size: 28rpx; color: var(--fg); }
.upload-actions { display: flex; flex-direction: column; gap: 28rpx; margin-top: 40rpx; }
.upload-action-btn { display: block; width: 92%; margin-left: auto; margin-right: auto; }
.cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.cat-chip { display: flex; align-items: center; justify-content: center; min-height: 76rpx; border-radius: 999rpx; border: 1px solid var(--border); background: var(--surface); color: var(--fg-2); font-size: 26rpx; }
.cat-chip.on { background: var(--accent); border-color: var(--accent); color: var(--accent-on); font-weight: 600; }
.cat-chip-hover { opacity: 0.85; }
