/* ============ iconfont（由 scripts/generate-icons.js 生成，内联以避免 @import 解析差异） ============ */
@font-face {
  font-family: "iconfont";
  src: url('./assets/icons/iconfont.ttf') format('truetype');
}

[class^="iconfont-"], [class*=" iconfont-"] {
  font-family: 'iconfont' !important;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.icon-avatar:before { content: "\e001"; }
.icon-back:before { content: "\e002"; }
.icon-camera:before { content: "\e003"; }
.icon-check:before { content: "\e004"; }
