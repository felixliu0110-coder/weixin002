/* ============ 全局设计 token（迁移自 weixin002/assets/proto.css） ============ */
page {
  /* 基础色板 */
  --bg: #FBF5ED;
  --surface: #FFFFFF;
  --surface-2: #F6F1E9;
  --fg: #1F1D1B;
  --fg-2: #4A423C;
  --muted: #8F8378;
  --border: #EADFD3;
  --border-soft: #F2EBE3;

  /* 强调色 */
  --accent: #E3A595;
  --accent-deep: #C98F80;
  --accent-strong: #D4978A;
  --accent-soft: #F8E3DB;
  --accent-tab: #E8B4A6;
  --ring-track: #F0D6CC;
  --danger: #C0392B;
  --tag-bg: #F0EDE8;
  --btn-soft: #F5EDE4;
  --search-bg: #F5F3EE;
  --backdrop: #EFEAE2;
  --accent-on: #FFFFFF;
  --mask: rgba(31, 29, 27, 0.45);

  /* 字体 */
  --font-body: "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei", system-ui, sans-serif;
  --font-mono: Consolas, "SF Mono", ui-monospace, monospace;

  /* 结构 */
  --nav-h: 44px;
  --tabbar-h: 56px;
  --radius-sm: 24rpx;
  --radius-md: 32rpx;
  --radius-lg: 40rpx;
  --radius-pill: 999rpx;
  --shadow-card: 0 10rpx 28rpx rgba(70, 52, 40, 0.07);
  --shadow-raise: 0 14rpx 34rpx rgba(70, 52, 40, 0.12);
  --ease: cubic-bezier(0.28, 0, 0.22, 1);

  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-body);
  font-size: 30rpx;
  -webkit-font-smoothing: antialiased;
}

view, text, button, image, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; background: none; font: inherit; line-height: inherit; }
button::after { border: 0; }
image { display: block; }

/* 图标字体基类 */
.iconfont {
  font-family: "iconfont" !important;
  font-size: 44rpx;
  color: inherit;
  line-height: 1;
}

/* 等宽数字 */
.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

/* ============ 页面骨架与向导公共样式（迁移自 proto.css） ============ */
.content { flex: 1; min-height: 0; overflow-y: auto; padding: 4px 20px 24px; }
.footer-bar {
  flex: 0 0 auto;
  padding: 10px 20px calc(12px + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1px solid var(--border-soft);
  display: flex;
  gap: 10px;
}
.footer-bar .btn { flex: 1; }

.steps { display: flex; gap: 6px; padding: 2px 0 4px; }
.steps i { flex: 1; height: 4px; border-radius: 2px; background: var(--border); }
.steps i.on { background: var(--accent); }

.subtitle { font-size: 26rpx; color: var(--fg-2); margin: 4rpx 4rpx 32rpx; line-height: 1.6; }
.step-note { font-size: 25rpx; color: var(--fg-2); line-height: 1.65; margin: 28rpx 4rpx 0; }

.sec-hd { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 44rpx 4rpx 24rpx; }
.sec-hd h2 { font-size: 34rpx; font-weight: 600; color: var(--fg); }
.sec-hd .hint { font-size: 24rpx; color: var(--fg-2); }

.field { margin-top: 36rpx; }
.field .fl { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 20rpx; }
.field .fl label { font-size: 28rpx; color: var(--fg-2); }
.field .fl .val { font-size: 36rpx; font-weight: 700; font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--fg); }
.field .fl .val small { font-size: 26rpx; font-weight: 500; color: var(--fg-2); margin-left: 4rpx; }
.field .fl .hint { font-size: 24rpx; color: var(--fg-2); }

.num-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.num-card { border: 1px solid var(--border-soft); background: var(--surface); border-radius: var(--radius-md); padding: 24rpx 16rpx 20rpx; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.num-card .nc-name { font-size: 25rpx; color: var(--fg-2); }
.num-card .nc-val { font-size: 38rpx; font-weight: 700; font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--fg); }
.num-card .nc-val small { font-size: 22rpx; font-weight: 500; color: var(--fg-2); }
.num-card .nc-step { display: flex; gap: 8px; margin-top: 12rpx; }
.num-card .nc-step .step-btn { width: 60rpx; height: 60rpx; border-radius: 50%; border: 1px solid var(--border); background: var(--surface); color: var(--fg-2); display: flex; align-items: center; justify-content: center; }
.num-card .nc-step .iconfont { font-size: 28rpx; }

.row-toggle { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 104rpx; padding: 16rpx 0; }
.row-toggle .rt-main { flex: 1; min-width: 0; }
.row-toggle .rt-title { font-size: 30rpx; font-weight: 500; }
.row-toggle .rt-sub { font-size: 24rpx; color: var(--fg-2); margin-top: 4rpx; }

.chip-row { display: flex; gap: 20rpx; flex-wrap: wrap; }
.chip-row .chip { flex: 1; min-width: 0; }
