/* ============ iconfont（由 scripts/generate-icons.js 生成，base64 内嵌） ============ */
@font-face {
  font-family: "iconfont";
  src: url('data:font/truetype;charset=utf-8;base64,') format('truetype');
}

.iconfont {
  font-family: "iconfont" !important;
  font-size: 44rpx;
  color: inherit;
  line-height: 1;
}

.icon-avatar:before { content: "\e001"; }
.icon-back:before { content: "\e002"; }
.icon-camera:before { content: "\e003"; }
.icon-check:before { content: "\e004"; }
.icon-chevron-right:before { content: "\e005"; }
.icon-clock:before { content: "\e006"; }
.icon-export:before { content: "\e007"; }
.icon-feedback:before { content: "\e008"; }
.icon-hanger:before { content: "\e009"; }
.icon-heart:before { content: "\e00a"; }
.icon-home:before { content: "\e00b"; }
.icon-minus:before { content: "\e00c"; }
.icon-ok:before { content: "\e00d"; }
.icon-photo:before { content: "\e00e"; }
.icon-plus:before { content: "\e00f"; }
.icon-rotate:before { content: "\e010"; }
.icon-ruler:before { content: "\e011"; }
.icon-save:before { content: "\e012"; }
.icon-search:before { content: "\e013"; }
.icon-settings:before { content: "\e014"; }
