/* ===== TabBar 组件 ===== */
.tabbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 0.5px solid var(--border-soft);
  padding: 12rpx 40rpx calc(12rpx + env(safe-area-inset-bottom));
  min-height: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  position: relative;
  z-index: 60;
}

/* 单个 Tab */
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 8rpx 0 4rpx;
  position: relative;
}

/* 图标容器 */
.tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* ===== CSS 绘制图标（统一 2px 描边线条风格）===== */

/* 主页：房子 */
.ic-home {
  width: 44rpx;
  height: 40rpx;
  position: relative;
}
.ic-home::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 4rpx;
  width: 36rpx;
  height: 22rpx;
  border: 2.5px solid var(--muted);
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  transition: border-color 0.25s ease;
}
.ic-home::after {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-bottom: 18rpx solid var(--muted);
  transition: border-bottom-color 0.25s ease;
}
.ic-home.on::before { border-color: var(--accent-text); }
.ic-home.on::after { border-bottom-color: var(--accent-text); }

/* 试衣：衣架 */
.ic-tryon {
  width: 44rpx;
  height: 40rpx;
  position: relative;
}
.ic-tryon::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 3px;
  height: 10rpx;
  background: var(--muted);
  border-radius: 2rpx;
  transition: background 0.25s ease;
}
.ic-tryon::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 28rpx;
  border: 2.5px solid var(--muted);
  border-radius: 18rpx 18rpx 10rpx 10rpx;
  border-top: 2.5px solid var(--muted);
  transition: border-color 0.25s ease;
}
.ic-tryon.on::before { background: var(--accent-text); }
.ic-tryon.on::after { border-color: var(--accent-text); }

/* 收藏：心形 */
.ic-heart {
  width: 44rpx;
  height: 40rpx;
  position: relative;
}
.ic-heart::before,
.ic-heart::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 32rpx;
  border: 2.5px solid var(--muted);
  border-bottom: none;
  border-radius: 20rpx 20rpx 0 0;
  transition: border-color 0.25s ease;
}
.ic-heart::before {
  left: 4rpx;
  top: 4rpx;
  transform: rotate(-45deg);
  transform-origin: 100% 100%;
}
.ic-heart::after {
  right: 4rpx;
  top: 4rpx;
  transform: rotate(45deg);
  transform-origin: 0 100%;
}
.ic-heart.on::before,
.ic-heart.on::after { border-color: var(--accent-text); }

/* 我的：人形 */
.ic-profile {
  width: 44rpx;
  height: 40rpx;
  position: relative;
}
.ic-profile::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  border: 2.5px solid var(--muted);
  border-radius: 50%;
  transition: border-color 0.25s ease;
}
.ic-profile::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 18rpx;
  border: 2.5px solid var(--muted);
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
  transition: border-color 0.25s ease;
}
.ic-profile.on::before,
.ic-profile.on::after { border-color: var(--accent-text); }

/* 文字标签 */
.tab-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 10rpx;
  transition: all 0.25s ease;
  letter-spacing: 0.5rpx;
}

/* 底部指示器（短横线） */
.tab-indicator {
  width: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--accent);
  margin-top: 6rpx;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ===== 选中态 ===== */
.tab.on .tab-label {
  color: var(--accent-text);
  font-weight: 600;
  transform: translateY(-1rpx);
}

.tab.on .tab-indicator {
  width: 32rpx;
}

/* 点击反馈 */
.tab-hover {
  opacity: 0.7;
}

/* ===== navMode 模式 ===== */
.tabbar.nav .tab.on .tab-indicator {
  background: var(--accent-deep);
}

/* ===== pill 模式 ===== */
.tabbar.pill .tab.on .tab-indicator {
  background: var(--accent-strong);
}
