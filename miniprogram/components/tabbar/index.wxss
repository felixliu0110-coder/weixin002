/* ===== TabBar 组件 ===== */
.tabbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 0.5px solid var(--border-soft);
  padding: 12rpx 40rpx calc(12rpx + env(safe-area-inset-bottom));
  min-height: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
  position: relative;
  z-index: 60;
}

/* 单个 Tab */
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 8rpx 0 4rpx;
  position: relative;
  cursor: pointer;
}

/* 图标容器 */
.tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.55;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  filter: grayscale(30%);
}

/* 文字标签 */
.tab-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 6rpx;
  transition: all 0.25s ease;
  letter-spacing: 0.5rpx;
}

/* 底部指示器（短横线） */
.tab-indicator {
  width: 0;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--accent);
  margin-top: 8rpx;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ===== 选中态 ===== */
.tab.on .tab-icon {
  opacity: 1;
  filter: grayscale(0%);
  transform: translateY(-2rpx) scale(1.12);
}

.tab.on .tab-label {
  color: var(--accent-text);
  font-weight: 600;
  transform: translateY(-1rpx);
}

.tab.on .tab-indicator {
  width: 32rpx;
}

/* 点击反馈 */
.tab-hover {
  opacity: 0.7;
}

/* ===== navMode 模式（非 Tab 页导航用）=====*/
.tabbar.nav .tab.on .tab-indicator {
  background: var(--accent-deep);
}

/* ===== pill 模式（Tab 页用）=====*/
.tabbar.pill .tab.on .tab-indicator {
  background: var(--accent-strong);
}
