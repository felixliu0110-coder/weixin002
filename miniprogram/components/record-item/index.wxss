.record { background: var(--surface); border: 1rpx solid var(--border-soft); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-card); transition: all 0.2s var(--ease); }
.record-hover { transform: scale(0.97); box-shadow: var(--shadow-card-hover); }
.r-img { position: relative; }
.r-img image { width: 100%; height: 420rpx; }
.r-img image.contain { object-fit: contain; }
.r-ai { position: absolute; top: 16rpx; right: 16rpx; background: rgba(31,29,27,0.65); color: var(--accent-on); font-size: 20rpx; padding: 6rpx 16rpx; border-radius: 999rpx; backdrop-filter: blur(8rpx); }
.r-video { position: absolute; left: 16rpx; bottom: 16rpx; background: rgba(31,29,27,0.65); color: #FFFFFF; font-size: 20rpx; padding: 6rpx 14rpx; border-radius: 999rpx; display: flex; align-items: center; gap: 6rpx; backdrop-filter: blur(8rpx); }
.video-ic { width: 22rpx; height: 22rpx; }
.r-check { position: absolute; top: 16rpx; left: 16rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 12rpx rgba(227, 165, 149, 0.40); }
.check-img { width: 26rpx; height: 26rpx; }
.r-meta { padding: 20rpx 22rpx 24rpx; }
.r-name { font-size: 27rpx; font-weight: 600; }
.r-date { font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }
