.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  padding: 0 34rpx;
  border-radius: 20rpx;
  background: var(--accent);
  color: var(--accent-on);
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 0;
  box-shadow: var(--shadow-btn);
  transition: filter .16s var(--ease), transform .12s var(--ease), box-shadow .16s ease;
}
.btn-hover { filter: brightness(1.04); transform: scale(.985); }
.btn.secondary { background: var(--surface); border: 1rpx solid var(--border); color: var(--fg); font-weight: 550; box-shadow: none; }
.btn.danger { background: var(--danger); box-shadow: 0 5rpx 16rpx rgba(183,74,61,.18); }
.btn.dark { background: var(--fg); box-shadow: 0 5rpx 16rpx rgba(36,33,31,.16); }
.btn.sm { min-height: 72rpx; padding: 0 26rpx; font-size: 27rpx; border-radius: 18rpx; }
.btn.disabled { background: #E9E4DE; color: #AAA098; box-shadow: none; border: 0; }
